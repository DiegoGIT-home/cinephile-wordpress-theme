# ==============================================================================
# Cinephile WordPress Theme - .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor & IDE Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak

# Logs & Databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log
error_log

# Environment & Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# Temporary files & Caches
*.tmp
*.temp
.sass-cache/
.cache/

# Node & Package Managers (if ever used for assets)
node_modules/
