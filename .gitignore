# ==============================================================================
# Cinephile WordPress Theme - .gitignore
# Solo file strettamente necessari per la produzione e distribuzione del tema
# ==============================================================================

# 1. File di Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# 2. Ambienti IDE, Editor e Configurazioni Agente AI
.vscode/
.idea/
.antigravity/
.agents/
.gemini/
*.sublime-project
*.sublime-workspace

# 3. File Operativi Interni, Note di Sviluppo e Prompt Privati
PROMPT_INIZIALE.md
README-antigraviti.md
github.txt
*.todo
*.notes

# 4. Risorse Grezze di Lavoro (gestite dagli script shell locali)
assets/raw/

# 5. Log di Sistema e File Temporanei
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug.log
error_log
*.tmp
*.bak
*.orig

# 6. Pacchetti, Database e File Sensibili
*.sql
*.sql.gz
*.sqlite
*.zip
*.tar.gz
*.rar
.env
.env.*
*.pem
*.key

# 7. Dipendenze e Build Artifacts
node_modules/
vendor/
.sass-cache/
.cache/

